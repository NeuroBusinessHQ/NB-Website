    "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <url>\n    <loc>https://neurobusiness.one/</loc>\n    <lastmod>2026-07-25T11:10:00+00:00</lastmod>\n  </url>\n  <url>\n    <loc>https://neurobusiness.one/solo</loc>\n    <lastmod>2026-07-25T11:10:00+00:00</lastmod>\n  </url>\n  <url>\n    <loc>https://neurobusiness.one/teams</loc>\n    <lastmod>2026-07-25T11:10:00+00:00</lastmod>\n  </url>\n  <url>\n    <loc>https://neurobusiness.one/coaches</loc>\n    <lastmod>2026-07-31T00:00:00+00:00</lastmod>\n  </url>\n  <url>\n    <loc>https://neurobusiness.one/practitioner/apply/</loc>\n    <lastmod>2026-07-31T00:00:00+00:00</lastmod>\n  </url>\n  <url>\n    <loc>https://neurobusiness.one/quiz</loc>\n    <lastmod>2026-07-25T11:10:00+00:00</lastmod>\n  </url>\n</urlset>\n"
